DATA_DIR=./data
TRACE_DIR=./traces
KB_DIR=./data/kb
DB_PATH=./data/tickets.db

# gigachat (по умолчанию) или openai
LLM_PROVIDER=gigachat
MODEL="GigaChat-3-Ultra"

GIGACHAT_BASE_URL="https://api.giga.chat/v1"
GIGACHAT_AUTH_KEY=authorization_key_for_gigachat

# Для LLM_PROVIDER=openai укажите OPENAI_API_KEY и модель OpenAI в MODEL.
# OPENAI_BASE_URL необязателен; без него используется API OpenAI.
OPENAI_API_KEY=authorization_key_for_openai
OPENAI_BASE_URL="https://api.openai.com/v1"