{
  "max_steps": 8,
  "max_history_messages": 40,
  "session_timeout": 300.0,
  "llm_timeout": 120.0,
  "servers": [
    {
      "name": "tickets",
      "transport": {
        "type": "stdio",
        "command": "python",
        "args": ["-m", "mcp_assistant.servers.tickets"] 
      },
      "tool_timeout": 30.0,
      "always_confirm_by_server": ["update_status", "add_comment"]
    },
    {
      "name": "knowledge",
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:8000/mcp"
      },
      "tool_timeout": 30.0,
      "always_confirm_by_server": []
    }
  ]
}